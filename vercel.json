{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://cornflour.pythonanywhere.com/api/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "https://cornflour.pythonanywhere.com/api/:path"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
